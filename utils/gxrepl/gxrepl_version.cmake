# 11/10/2026: gxrepl_stamp(TARGET): "gxrepl version" prints the git head of
# the DataReel sources (with +dirty when they have uncommitted changes) and
# the time the binary was built. Outside a git checkout the head reads
# "unknown".
#
# Every build checks the git head (a small step that rewrites
# <target>_stamp/head.txt only when it changed). The stamp source (the head
# and the build time) is written again only when the head, gxrepl's own
# sources, the DataReel headers or the DataReel library changed, so the time
# is when gxrepl was last really rebuilt, and a build with no change makes
# the same binary (automate/gxrepl_build.sh then keeps gxrepl.prev).
#
# The same file runs as a script (cmake -P) for those two steps.
if(GXREPL_STAMP_MODE STREQUAL "head")
  set(_head "unknown")
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${DIR}" rev-parse --short=12 HEAD
                    OUTPUT_VARIABLE _h OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rc)
    if(_rc EQUAL 0 AND NOT _h STREQUAL "")
      set(_head "${_h}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${DIR}" status --porcelain --untracked-files=no -- ../..
                      OUTPUT_VARIABLE _s OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT _s STREQUAL "")
        set(_head "${_head}+dirty")
      endif()
    endif()
  endif()
  file(WRITE "${OUT}.tmp" "${_head}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
  file(REMOVE "${OUT}.tmp")
  return()
elseif(GXREPL_STAMP_MODE STREQUAL "source")
  file(READ "${HEAD}" _head)
  string(STRIP "${_head}" _head)
  string(TIMESTAMP _when "%Y-%m-%d %H:%M:%S UTC" UTC)
  file(WRITE "${OUT}" "// Generated by gxrepl_version.cmake: do not edit\n"
       "const char *gxrepl_git_head() { return \"${_head}\"; }\n"
       "const char *gxrepl_build_time() { return \"${_when}\"; }\n")
  return()
endif()

set(GXREPL_VERSION_CMAKE "${CMAKE_CURRENT_LIST_FILE}")
function(gxrepl_stamp target)
  set(_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  set(_d "${CMAKE_CURRENT_BINARY_DIR}/${target}_stamp")
  file(MAKE_DIRECTORY "${_d}")
  set(_head "${_d}/head.txt")
  set(_src "${_d}/stamp.cpp")
  add_custom_target(${target}_git_head
    COMMAND "${CMAKE_COMMAND}" -DGXREPL_STAMP_MODE=head "-DDIR=${_dir}" "-DOUT=${_head}" -P "${GXREPL_VERSION_CMAKE}"
    BYPRODUCTS "${_head}" VERBATIM)
  get_target_property(_srcs ${target} SOURCES)
  file(GLOB _hdrs "${_dir}/../../include/*.h")
  add_custom_command(OUTPUT "${_src}"
    COMMAND "${CMAKE_COMMAND}" -DGXREPL_STAMP_MODE=source "-DHEAD=${_head}" "-DOUT=${_src}" -P "${GXREPL_VERSION_CMAKE}"
    DEPENDS "${_head}" ${_srcs} ${_hdrs} datareel "$<TARGET_FILE:datareel>" "${GXREPL_VERSION_CMAKE}"
    VERBATIM)
  target_sources(${target} PRIVATE "${_src}")
  add_dependencies(${target} ${target}_git_head)
  target_compile_definitions(${target} PRIVATE GXREPL_STAMPED=1)
endfunction()
