# --------------------------------------------------------------- 
# Makefile Contents: DataReel 7 settings for Linux makefile builds
# C/C++ Compiler Used: GNU g++ 8 or higher (C++17)
# Produced By: DataReel Software Development Team
# File Creation Date: 05/25/2001
# Date Last Modified: 10/26/2026
# --------------------------------------------------------------- 
# 10/26/2026: DataReel 7 builds with CMake on Linux and Windows (see
# CMakeLists.txt). These settings are kept for the Linux makefile in
# build/ and for applications that include this file. Settings that
# no longer change the code have been removed.
#
# Options (pass on the make command line or set in the environment):
#   LARGEFILES=1  Build the 64-bit database engine (64-bit file offsets).
#                 Files written by a 32-bit build cannot be read by a
#                 64-bit build and the reverse, so match your data files.
#   FINAL=1       Release build (no __DEBUG__ code)
#   NATIVE_TYPES=0 Use the portable gxINT/gxFLOAT byte classes instead
#                 of native types (only for data files written that way)
# --------------------------------------------------------------- 

OBJ_EXT = .o
EXE_EXT = 
LIB_EXT = .a
DLIB_EXT = .so
PATHSEP = /

SHAREDLIB_VERSION = 7.0
SHAREDLIB_EXT = $(DLIB_EXT).$(SHAREDLIB_VERSION)
LIB_INSTALL_DIR = ../lib
ADD_INC_PATHS = -I$(GCODE_LIB_DIR)$(PATHSEP)include

CXX ?= g++
CXXFLAGS ?= -O2 -Wall
CXXSTD = -std=c++17
LIBCOMPILE_FLAGS = -fPIC

ifeq ($(FINAL),1)
DEBUG_DEFMACS = -D__NO_DEBUG_OPTIONS__
else
DEBUG_DEFMACS = -D__DEBUG__
endif

ifeq ($(LARGEFILES),1)
LARGEFILE_DEFMACS = -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 \
-D_LARGE_FILES -D__64_BIT_DATABASE_ENGINE__ -D__ENABLE_64_BIT_INTEGERS__
else
LARGEFILE_DEFMACS = -D_FILE_OFFSET_BITS=64
endif

NATIVE_TYPES ?= 1
ifeq ($(NATIVE_TYPES),1)
TYPES_DEFMACS = -D__USE_NATIVE_INT_TYPES__ -D__USE_NATIVE_FLOAT_TYPES__
else
TYPES_DEFMACS = -D__X86__
endif

DATABASE_DEFMACS = -D__USE_DATABASE_CACHE__ -D__USE_BTREE_CACHE__ \
-D__USE_BINARY_SEARCH__ -D__USE_SINGLE_COMPARE__
SERIAL_COMM_DEFMACS = -D__LINUX_BAUD_RATE_38400_SUPPORT__ \
-D__LINUX_BAUD_RATE_57600_SUPPORT__ -D__LINUX_BAUD_RATE_115200_SUPPORT__ \
-D__LINUX_BAUD_RATE_230400_SUPPORT__ -D__LINUX_BAUD_RATE_460800_SUPPORT__

DEFMACS = -DGNU -D__UNIX__ -D__LINUX__ -D__POSIX__ -D__CONSOLE__ \
$(DEBUG_DEFMACS) $(LARGEFILE_DEFMACS) $(TYPES_DEFMACS) \
$(DATABASE_DEFMACS) $(SERIAL_COMM_DEFMACS)

COMPILE_FLAGS = $(CXXSTD) $(CXXFLAGS) $(ADD_INC_PATHS) $(DEFMACS)
COMPILE_ONLY = -c
OUTPUT = -o

# TLS uses the system OpenSSL (openssl-devel), 1.1.1 or higher
LINK_LIBRARIES = -lssl -lcrypto -lpthread
LINKER_FLAGS = 

# GCC 8 (RHEL 8) needs a separate library for std::filesystem
GCC_MAJOR := $(shell $(CXX) -dumpversion 2>/dev/null | cut -d. -f1)
ifeq ($(GCC_MAJOR),8)
LINK_LIBRARIES := $(LINK_LIBRARIES) -lstdc++fs
endif

LIBUTIL = ar
LIBUTIL_FLAGS = ruv
RANLIB_UTIL = ranlib
SHARED_LIBUTIL = $(CXX) -shared
LN_S = ln -sf
# --------------------------------------------------------------- 
