# --------------------------------------------------------------- 
# Makefile Contents: Common settings for MSVC make files
# C/C++ Compiler Used: Visual Studio 2022 and Visual Studio 2026
# Produced By: DataReel Software Development Team
# File Creation Date: 05/25/2001
# Date Last Modified: 10/24/2026
# --------------------------------------------------------------- 
!IF "$(FINAL)" == ""
FINAL = 0 # Default to debug configuration
!ENDIF

!IF "$(64BITCFG)" == ""
64BITCFG = 0 # Default to 32-bit configuration
!ENDIF

!IF "$(USESSL)" == ""
USESSL = 0 # Default to native Windows Schannel SSL, 1 = OpenSSL
!ENDIF

!IF "$(FINAL)" == "1"
NODEBUG = 1 # No debugging information
!ENDIF

# 10/24/2026: The win32.mak file is no longer part of the Windows SDK.
# The compiler and linker flags it used to set are defined below. The
# target CPU (x86, x64, or ARM64) comes from the vcvars BAT file used
# to set the build ENV. See the env/msvc*.bat files.

# Define file extensions and path variables
OBJ_EXT = .obj
EXE_EXT = .exe 
LIB_EXT = .lib
SHAREDLIB_EXT = .dll
PATHSEP = /

# Installation directory for the DLL
LIB_INSTALL_DIR = ..\lib

# Setup include paths
ADD_INC_PATHS = -I$(GCODE_LIB_DIR)$(PATHSEP)include

!IF "$(USESSL)" == "1"
ADD_INC_PATHS = $(ADD_INC_PATHS) -I$(OPENSSL_DIR)$(PATHSEP)include
!ENDIF

# Define debug macros specific to the gxcode library
!IF "$(FINAL)" == "1"
DEBUG_DEFMACS = # No debugging information
!ELSE
DEBUG_DEFMACS = # Add debug directives here
# MSVC Leak test debug flags. NOTE: Also requires /MDd or /MTd compiler flag.
# -D__MSVC_DEBUG__
# Debug flags used to disable platform interoperatble data types
# -D__USE_NATIVE_INT_TYPES__   
# -D__USE_NATIVE_FLOAT_TYPES__ 
!ENDIF

# Define 64-bit macros specific to the gxcode library
!IF "$(64BITCFG)" == "1"
64BIT_DEFMACS = -D__64_BIT_DATABASE_ENGINE__
!ELSE
64BIT_DEFMACS = # Use 32-bit configuration
!ENDIF

TYPES_DEFMACS = -D__USE_NATIVE_INT_TYPES__ -D__USE_NATIVE_FLOAT_TYPES__ 
ANSI_DEFMACS = -D__USE_ANSI_CPP__
#BTREE_DEFMACS = -D__USE_BINARY_SEARCH__ -D__USE_SINGLE_COMPARE__
CPP_DEFMACS = -D__USE_CPP_IOSTREAM__ #-D__CPP_EXCEPTIONS__
DATABASE_DEFMACS = -D__USE_DATABASE_CACHE__ -D__USE_BTREE_CACHE__
#DEVCACHE_DEFMACS = -D__VMEMORY_BUFFER__ # -D__SMEMORY_BLOCK__
DISPLAY_DEFMACS = -D__CONSOLE__ #-D__CURSES__ #__wxWIN201__ # __wxWIN168B__
FILESYS_DEFMACS = -D__NTFS__
TESTCODE_DEFMACS = -D__USE_CRC32_TABLE_FUNCTIONS__ -D__USE_EDS_TEST_FUNCTIONS__
PS_DEFMACS = -D__USE_POSTSCRIPT_PRINTING__ 
HTM_DEFMACS = -D__USE_HTM_PRINTING__ 
TXT_DEFMACS = -D__USE_TEXT_PRINTING__
#COMPILER_DEFMACS = -D__MSDEVNET__ # Microsoft Visual C++ .NET
# 10/24/2026: Quiet the VS 2022/2026 C4996 deprecation warnings for the
# standard C string, POSIX, and WinSock 1.1 functions used by the library.
# Comment out to see these warnings.
MSVC_DEFMACS = -D_CRT_SECURE_NO_WARNINGS -D_CRT_NONSTDC_NO_WARNINGS \
-D_WINSOCK_DEPRECATED_NO_WARNINGS \
-D_HAS_STD_BYTE=0 # Avoid std::byte and Windows byte conflicts with /std:c++17
#THREAD_DEFMACS = -D__GUI_THREAD_SAFE__
UNICODE_DEMACS = -D__HAS_UNICODE__
#TERMIO_DEFMACS = -D__USE_TERMINAL_IO__

# 10/24/2026: SSL is always built into the library. By default the
# gxSSL class uses the native Windows Schannel (SSPI) API so no OpenSSL
# build is needed. Set USESSL=1 to build with OpenSSL instead.
!IF "$(USESSL)" == "1"
SSL_DEFMACS = -D__USE_GX_SSL_EXTENSIONS__
!ELSE
SSL_DEFMACS = -D__USE_GX_SSL_EXTENSIONS__ -D__USE_GX_SCHANNEL__
!ENDIF

# Define macros specific to the gxcode library
DEFMACS = -D__WIN32__ -D__X86__ -D__MSVC__ -D__HAS__BEGINTHREADEX__ \
$(64BIT_DEFMACS) $(ANSI_DEFMACS) $(BTREE_DEFMACS) $(CPP_DEFMACS) \
$(DEBUG_DEFMACS) $(DEVCACHE_DEFMACS) $(DISPLAY_DEFMACS) $(FILESYS_DEFMACS) \
$(TESTCODE_DEFMACS) $(PS_DEFMACS) $(HTM_DEFMACS) $(TXT_DEFMACS) \
$(COMPILER_DEFMACS) $(DATABASE_DEFMACS) $(UNICODE_DEMACS) $(TERMIO_DEFMACS) \
$(SSL_DEFMACS) $(TYPES_DEFMACS) $(MSVC_DEFMACS)

# Define macros for compiler and linker
CC = cl
CPP = cl
LINKER = link
##LIBUTIL = $(implib)
LIBUTIL = lib

# Define compiler and linker flags macros
# NOTE: The static library and the programs that link to it use the
# static C runtime (/MT release, /MTd debug). If you're using the MSVC
# leak test functions you must compile the library with the /MTd or
# /MDd compiler flag.
!IF "$(FINAL)" == "1"  # No debugging information
COMPILE_FLAGS = /nologo /MT /W3 /EHsc /GR /O2 /DNDEBUG \
$(ADD_INC_PATHS) $(DEFMACS)
LINKER_FLAGS = /nologo /incremental:no
!ELSE
COMPILE_FLAGS = /nologo /MTd /W3 /EHsc /GR /Z7 /Od /D_DEBUG \
$(ADD_INC_PATHS) $(DEFMACS)
LINKER_FLAGS = /nologo /debug
!ENDIF
COMPILE_ONLY = /c
LIBUTIL_FLAGS = /nologo

# WIN32 library files
LINK_LIBRARIES = kernel32.lib user32.lib gdi32.lib winspool.lib \
comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib \
wsock32.lib

!IF "$(USESSL)" == "1"
# NOTE: OpenSSL 3.x static libraries also need ws2_32.lib and crypt32.lib
LINK_LIBRARIES = $(LINK_LIBRARIES) crypt32.lib ws2_32.lib \
$(OPENSSL_DIR)$(PATHSEP)lib$(PATHSEP)libssl.lib \
$(OPENSSL_DIR)$(PATHSEP)lib$(PATHSEP)libcrypto.lib 
!ELSE
# Native Windows Schannel SSL libraries
LINK_LIBRARIES = $(LINK_LIBRARIES) secur32.lib crypt32.lib ncrypt.lib ws2_32.lib
!ENDIF

# --------------------------------------------------------------- 
